{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": false,
  "automerge": false,
  "enabledManagers": [
    "npm",
    "cargo",
    "github-actions"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "ignorePaths": [
    "**/node_modules/**",
    "docs/**",
    "vendor/**",
    "**/package-lock*.json"
  ],
  "lockFileMaintenance": {
    "enabled": false
  }
}
