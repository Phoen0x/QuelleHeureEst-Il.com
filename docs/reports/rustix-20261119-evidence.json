  "probe_manifest": "[package]\nname = \"qh-rustix-safe-probe\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n[workspace]\n[dependencies]\nrustix = { version = \"=1.1.6\", features = [\"fs\"] }\ntempfile = \"=3.27.0\"\n",
  "probe_source": "// FR// Sonde synthétique exécutée exclusivement contre rustix 1.1.6 corrigé.\n// EN// Synthetic probe executed exclusively against fixed rustix 1.1.6.\n#[cfg(test)]\nmod tests {\n    use rustix::fs::*;\n    use std::mem::MaybeUninit;\n    fn fixture() -> (tempfile::TempDir, std::path::PathBuf, std::fs::File) {\n        let dir = tempfile::tempdir().unwrap();\n        let path = dir.path().join(\"synthetic\");\n        let file = std::fs::File::create(&path).unwrap();\n        setxattr(&path, \"user.qh_safe\", b\"safe\", XattrFlags::empty()).unwrap();\n        (dir, path, file)\n    }\n    #[test]\n    fn queries_and_normal_reads() {\n        let (_dir, path, file) = fixture();\n        assert_eq!(getxattr_query(&path, \"user.qh_safe\").unwrap(), 4);\n        assert_eq!(lgetxattr_query(&path, \"user.qh_safe\").unwrap(), 4);\n        assert_eq!(fgetxattr_query(&file, \"user.qh_safe\").unwrap(), 4);\n        assert!(listxattr_query(&path).unwrap() > 0);\n        assert!(llistxattr_query(&path).unwrap() > 0);\n        assert!(flistxattr_query(&file).unwrap() > 0);\n        let mut bytes = [0u8; 8];\n        assert_eq!(getxattr(&path, \"user.qh_safe\", &mut bytes).unwrap(), 4);\n        assert_eq!(&bytes[..4], b\"safe\");\n    }\n    #[test]\n    fn zero_buffers_and_full_vector_remain_empty() {\n        let (_dir, path, file) = fixture();\n        let mut bytes = [0u8; 0];\n        assert_eq!(getxattr(&path, \"user.qh_safe\", &mut bytes).unwrap(), 0);\n        assert_eq!(lgetxattr(&path, \"user.qh_safe\", &mut bytes).unwrap(), 0);\n        assert_eq!(fgetxattr(&file, \"user.qh_safe\", &mut bytes).unwrap(), 0);\n        assert_eq!(listxattr(&path, &mut bytes).unwrap(), 0);\n        assert_eq!(llistxattr(&path, &mut bytes).unwrap(), 0);\n        assert_eq!(flistxattr(&file, &mut bytes).unwrap(), 0);\n        let mut uninit: [MaybeUninit<u8>; 0] = [];\n        assert!(getxattr(&path, \"user.qh_safe\", &mut uninit).unwrap().0.is_empty());\n        assert!(listxattr(&path, &mut uninit).unwrap().0.is_empty());\n        let mut full = vec![42u8];\n        assert_eq!(full.len(), full.capacity());\n        assert_eq!(getxattr(&path, \"user.qh_safe\", rustix::buffer::spare_capacity(&mut full)).unwrap(), 0);\n        assert_eq!(full, vec![42]);\n    }\n    #[test]\n    fn tempfile_persist_and_cleanup() {\n        use std::io::{Read, Seek, SeekFrom, Write};\n        let dir = tempfile::tempdir().unwrap();\n        let mut file = tempfile::NamedTempFile::new_in(dir.path()).unwrap();\n        file.write_all(b\"synthetic safe data\").unwrap();\n        let path = dir.path().join(\"persisted\");\n        let mut persisted = file.persist(&path).unwrap();\n        persisted.seek(SeekFrom::Start(0)).unwrap();\n        let mut data = String::new();\n        persisted.read_to_string(&mut data).unwrap();\n        assert_eq!(data, \"synthetic safe data\");\n        drop(persisted);\n        let folder = dir.path().to_owned();\n        dir.close().unwrap();\n        assert!(!folder.exists());\n    }\n}\n",
