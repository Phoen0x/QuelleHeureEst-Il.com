  "upstream": {
    "sha": "3971101c82643035c15380c3f4af19ecccd09bb2",
    "message": "glib: collections: Fix theoretical use-after-frees if dropping an item panics\n\nThis is currently not a problem because all collections require the item\ntype to implement `TransparentType` or `TransparentPtrType`, which are\nunsafe traits that are only implemented by the `glib::wrapper!` macro\nand require the `Drop` impl to not panic (among other things).\n\nAs such this has no effect right now but is cleaner and might avoid bugs\nin the future if the requirements of the two traits are ever weakened.\n\nThanks to JuHyung Son for reporting.",
    "ptr_slice_patch": "@@ -83,13 +83,15 @@ impl<T: TransparentPtrType> Drop for PtrSlice<T> {\n     #[inline]\n     fn drop(&mut self) {\n         unsafe {\n+            let len = mem::replace(&mut self.len, 0);\n             if mem::needs_drop::<T>() {\n-                for i in 0..self.len {\n+                for i in 0..len {\n                     ptr::drop_in_place::<T>(self.ptr.as_ptr().add(i) as *mut T);\n                 }\n             }\n \n-            if self.capacity != 0 {\n+            let capacity = mem::replace(&mut self.capacity, 0);\n+            if capacity != 0 {\n                 ffi::g_free(self.ptr.as_ptr() as ffi::gpointer);\n             }\n         }\n@@ -263,13 +265,15 @@ impl<T: TransparentPtrType> Drop for IntoIter<T> {\n     #[inline]\n     fn drop(&mut self) {\n         unsafe {\n+            let len = mem::replace(&mut self.len, 0);\n             if mem::needs_drop::<T>() {\n-                for i in 0..self.len {\n+                for i in 0..len {\n                     ptr::drop_in_place::<T>(self.idx.as_ptr().add(i) as *mut T);\n                 }\n             }\n \n-            if !self.empty {\n+            let empty = mem::replace(&mut self.empty, true);\n+            if !empty {\n                 ffi::g_free(self.ptr.as_ptr() as ffi::gpointer);\n             }\n         }\n@@ -789,13 +793,12 @@ impl<T: TransparentPtrType> PtrSlice<T> {\n     #[inline]\n     pub fn clear(&mut self) {\n         unsafe {\n+            let len = mem::replace(&mut self.len, 0);\n             if mem::needs_drop::<T>() {\n-                for i in 0..self.len {\n+                for i in 0..len {\n                     ptr::drop_in_place::<T>(self.ptr.as_ptr().add(i) as *mut T);\n                 }\n             }\n-\n-            self.len = 0;\n         }\n     }\n \n@@ -929,14 +932,18 @@ impl<T: TransparentPtrType> PtrSlice<T> {\n         }\n \n         unsafe {\n-            while self.len > len {\n-                self.len -= 1;\n-                let p = self.ptr.as_ptr().add(self.len);\n-                ptr::drop_in_place::<T>(p as *mut T);\n-                ptr::write(\n-                    p,\n-                    Ptr::from(ptr::null_mut::<<T as GlibPtrDefault>::GlibType>()),\n-                );\n+            if mem::needs_drop::<T>() {\n+                while self.len > len {\n+                    self.len -= 1;\n+                    let p = self.ptr.as_ptr().add(self.len);\n+                    ptr::drop_in_place::<T>(p as *mut T);\n+                    ptr::write(\n+                        p,\n+                        Ptr::from(ptr::null_mut::<<T as GlibPtrDefault>::GlibType>()),\n+                    );\n+                }\n+            } else {\n+                self.len = len;\n             }\n         }\n     }"
